<!-- Overlay for an existing official LineageOS lineage-23.2 checkout. -->
<manifest>
  <remote name="meizu-sm8550-kernel" fetch="https://github.com/meizu-sm8550-kernel/" />

  <!-- Exact paths only: projects with the same names elsewhere are retained. -->
  <remove-project path="device/meizu/m2468" optional="true" />
  <remove-project path="device/meizu/m2468-kernel" optional="true" />
  <remove-project path="kernel/meizu/sm8550" optional="true" />
  <remove-project path="kernel/meizu/sm8550-modules" optional="true" />
  <remove-project path="kernel/meizu/sm8550-devicetrees" optional="true" />
  <!-- Retire the legacy duplicate Clang project; no replacement is fetched. -->
  <remove-project path="prebuilts/clang/host/linux-x86-kernel" optional="true" />

  <project name="android_device_meizu_m2468"
           path="device/meizu/m2468"
           remote="meizu-sm8550-kernel"
           revision="refs/heads/lineage-23.2" />
  <project name="android_kernel_meizu_sm8550"
           path="kernel/meizu/sm8550"
           remote="meizu-sm8550-kernel"
           revision="refs/heads/lineage-23.2" />
  <project name="android_kernel_meizu_sm8550-modules"
           path="kernel/meizu/sm8550-modules"
           remote="meizu-sm8550-kernel"
           revision="refs/heads/lineage-23.2" />
  <project name="android_kernel_meizu_sm8550-devicetrees"
           path="kernel/meizu/sm8550-devicetrees"
           remote="meizu-sm8550-kernel"
           revision="refs/heads/lineage-23.2" />

  <!-- Clang is provided by the ROM manifest and selected by platform defaults. -->
</manifest>
